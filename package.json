{
	"name": "@ventrata/octo-types",
	"version": "0.1.01",
	"private": false,
	"license": "ISC",
	"types": "dist/index.d.ts",
	"repository": {
		"url": "https://github.com/ventrata/octo-types"
	},
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"get:openapi:yaml": "ts-node src/utils/get-openapi-yaml.ts",
		"generate:models": "openapi --input src/openapi.yaml --output src/ --exportCore false --exportServices false --client none",
		"generate:schemas": "ts-node src/utils/generate-schemas.ts",
		"clean": "rm -rf dist",
		"generate": "npm run get:openapi:yaml && npm run generate:models && npm run generate:schemas && npm run fix",
		"build": "npx tsc",
		"build:dry": "tsc --noEmit",
		"build:dry:ci": "tsc --noEmit",
		"check": "npm run build:dry && npm run format && npm run lint",
		"fix": "biome check --write .",
		"format": "biome format",
		"format:fix": "biome format --write .",
		"lint": "biome lint",
		"lint:fix": "biome lint --write .",
		"audit": "npm audit",
		"prepare": "npm run build",
		"test": ""
	},
	"peerDependencies": {
		"zod": "^4.6.5"
	},
	"overrides": {
		"js-yaml": "4.3.2",
		"lodash": "4.18.1"
	},
	"devDependencies": {
		"@types/glob": "^8.1.0",
		"@types/node": "^22.20.4",
		"glob": "^11.1.0",
		"openapi-typescript-codegen": "^0.31.0",
		"ts-node": "^10.9.2",
		"ts-to-zod": "^5.1.0",
		"typescript": "^5.9.3",
		"zod": "^4.6.5"
	},
	"dependencies": {
		"@biomejs/biome": "2.5.14"
	}
}
