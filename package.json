{
  "name": "@octocloud/types",
  "version": "3.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "homepage": "https://github.com/octotravel/octo-types#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octotravel/octo-types.git"
  },
  "bugs": {
    "url": "https://github.com/octotravel/octo-types/issues"
  },
  "main": "dist/index.js",
  "scripts": {
    "get:openapi:yaml": "ts-node src/utils/get-openapi-yaml.ts",
    "generate:models": "rm -f src/models/types.gen.ts src/models/zod.gen.ts src/models/index.ts && openapi --input src/openapi.yaml --output src/ --exportCore false --exportServices false --client none",
    "generate:schemas": "ts-node src/utils/generate-schemas.ts",
    "generate:yup": "ts-node src/utils/generate-yup-schemas.ts",
    "clean": "rm -rf dist",
    "generate": "npm run get:openapi:yaml && npm run generate:models && npm run generate:schemas && npm run generate:yup && npm run fix",
    "build": "npx tsc",
    "build:dry": "tsc --noEmit",
    "build:dry:ci": "tsc --noEmit",
    "check": "npm run build:dry && npm run format && npm run lint",
    "fix": "biome check --write .",
    "format": "biome format",
    "format:fix": "biome format --write .",
    "lint": "biome lint",
    "lint:fix": "biome lint --write .",
    "audit": "npm audit",
    "test": "",
    "prepare": "npm run build"
  },
  "dependencies": {
    "yup": "0.32.11",
    "zod": "4.6.5"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/glob": "8.1.0",
    "@types/node": "22.9.0",
    "audit-ci": "7.1.0",
    "glob": "11.1.0",
    "openapi-typescript-codegen": "0.31.0",
    "ts-node": "10.9.2",
    "ts-to-zod": "5.1.0",
    "typescript": "5.7.2"
  },
  "packageManager": "yarn@4.9.2+sha512.1fc009bc09d13cfd0e19efa44cbfc2b9cf6ca61482725eb35bbc5e257e093ebf4130db6dfe15d604ff4b79efd8e1e8e99b25fa7d0a6197c9f9826358d4d65c3c"
}
